# SilentWaze — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# AWS RDS PostgreSQL connection string
# Format: postgresql://username:password@rds-endpoint.region.rds.amazonaws.com:5432/dbname
DATABASE_URL=postgresql://silentwaze_admin:your_password@your-rds-endpoint.ap-southeast-2.rds.amazonaws.com:5432/silentwaze
